# LLM API Key (REQUIRED)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Search API Keys (optional but recommended for better research)
SERPAPI_API_KEY=your_serpapi_key_here

# Image Generation (optional - for AI image generation)
STABILITY_API_KEY=your_stability_ai_key_here

# OpenAI Configuration
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o
TEMPERATURE=0.7

# Vector Database
CHROMADB_PATH=./chroma_db

# Brand Settings
DEFAULT_BRAND_NAME=Your Brand
DEFAULT_BRAND_VOICE=professional, informative, friendly
DEFAULT_TARGET_AUDIENCE=marketers and content creators
