# LLM API Keys (choose at least one)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Search API Keys (optional but recommended)
SERPAPI_API_KEY=your_serpapi_key_here

# Image Generation (optional)
STABILITY_API_KEY=your_stability_ai_key_here

# Configuration
DEFAULT_LLM_PROVIDER=anthropic  # Options: anthropic, openai, google
DEFAULT_MODEL=claude-3-5-sonnet-20241022
TEMPERATURE=0.7

# Vector Database
CHROMADB_PATH=./chroma_db

# Brand Settings
DEFAULT_BRAND_NAME=Your Brand
DEFAULT_BRAND_VOICE=professional, informative, friendly
DEFAULT_TARGET_AUDIENCE=marketers and content creators
